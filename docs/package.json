{
  "name": "superstac-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "check": "node scripts/check-node.mjs && fumadocs-mdx && tsc --noEmit",
    "start": "next start --hostname 0.0.0.0",
    "postinstall": "node scripts/check-node.mjs && fumadocs-mdx",
    "test:links": "node scripts/check-links.mjs",
    "predev": "node scripts/check-node.mjs && node scripts/sync-assets.mjs",
    "prebuild": "node scripts/check-node.mjs && node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.14",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "8"
  }
}
